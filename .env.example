# 行情与 AI
TICKFLOW_API_KEY=
DEEPSEEK_API_KEY=
ANSPIRE_API_KEYS=
ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.cn/v6
ANSPIRE_LLM_MODEL=deepseek-v4-pro

# 新闻搜索降级源（可选）
TAVILY_API_KEYS=
BRAVE_API_KEYS=
SERPAPI_API_KEYS=

# 博主观点自动同步
# 知乎优先用浏览器登录后的完整 Cookie 拉取作者回答/文章；过期后需重新获取
ZHIHU_COOKIE=
# 知乎数据开放平台 Access Secret，仅作 Cookie 失效时的兜底搜索
ZHIHU_ACCESS_SECRET=
# 浏览器登录雪球后复制的完整 Cookie；过期后需重新获取
XUEQIU_COOKIE=

# 金十数据官方 MCP（快讯/资讯/日历/宏观报价）
JIN10_MCP_TOKEN=
JIN10_MCP_URL=https://mcp.jin10.com/mcp

# 同花顺扶摇（龙虎榜等 A 股专项数据）
FUYAO_API_KEY=
FUYAO_API_BASE=https://fuyao.aicubes.cn

# 每日复盘推送（任选其一；也可以直接在「每日复盘」页面配置，界面配置优先）
# 未配置时只本地保存 data/daily-digest.json，不会静默失败
# 通用 webhook：POST { title, text }
DAILY_DIGEST_WEBHOOK=
# Server 酱 SendKey（sctapi.ftqq.com）
SERVERCHAN_KEY=
# 钉钉/飞书/企业微信机器人 webhook
DINGTALK_WEBHOOK=
FEISHU_WEBHOOK=
WECOM_WEBHOOK=
# 设为 1 时，交易日收盘后 15:05-16:30 自动生成并推送
DAILY_DIGEST_AUTO_PUSH=0

# 其它运行选项
STOCK_KLINE_TUNNEL=0
CLOUDFLARED_BIN=
HOST=127.0.0.1
PORT=4173
HTTPS_PROXY=
HTTP_PROXY=
